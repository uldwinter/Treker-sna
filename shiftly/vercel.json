{
  "headers":[
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]},
    {"source":"/","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]}
  ],
  "rewrites":[
    {"source":"/api/session","destination":"/api/index?action=session"},
    {"source":"/api/sign-in","destination":"/api/index?action=sign-in"},
    {"source":"/api/sign-up","destination":"/api/index?action=sign-up"},
    {"source":"/api/sign-out","destination":"/api/index?action=sign-out"},
    {"source":"/api/state","destination":"/api/index?action=state"},
    {"source":"/app/(.*)","destination":"/index.html"}
  ]
}
